{
  "name": "sebuh-net",
  "version": "0.1.0",
  "private": true,
  "description": "Sebuh.net Tezos development supporter site",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "bundle": "node scripts/build-wallet.mjs",
    "build": "npm run bundle && npm test",
    "check:deploy": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "verify:donations": "node scripts/verify-donations.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8790",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "@taquito/rpc": "^25.1.0",
    "@taquito/signer": "^25.1.0",
    "@taquito/taquito": "^25.1.0",
    "@taquito/utils": "^25.1.0",
    "@tezos-x/octez.connect-dapp": "5.0.3",
    "@tezos-x/octez.connect-types": "5.0.3",
    "buffer": "6.0.3"
  }
}
